# Postgres — vd Neon (khuyến nghị, tích hợp thẳng Vercel Marketplace), Supabase,
# hoặc tự host.
# Với Supabase: vào Project Settings -> Database -> Connect, lấy 2 connection
# string riêng biệt (bắt buộc vì "Direct connection" chỉ hỗ trợ IPv6):
#   DATABASE_URL: "Transaction pooler" (port 6543) — app dùng lúc chạy, hợp
#     với serverless/Vercel. Nhớ thêm ?pgbouncer=true vào cuối.
#   DIRECT_URL:   "Session pooler" (port 5432) — chỉ dùng khi chạy
#     `prisma migrate` (transaction pooler không hỗ trợ migration).
# Với Neon/tự host chỉ cần 1 connection string thường, điền cả 2 biến giống nhau.
DATABASE_URL=""
DIRECT_URL=""

# Email admin "bootstrap" — email này đăng nhập sẽ LUÔN có quyền vào /admin và
# không gỡ được qua UI. Các admin khác được admin này cấp quyền tại /admin/users
# (lưu ở cột User.role == "admin").
ADMIN_EMAIL=""

# Auth.js — lấy AUTH_SECRET bằng `npx auth secret` hoặc `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth credentials — tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chỉ cần cho app Android (Capacitor) — đăng nhập Google trong app dùng plugin
# native (không qua WebView, vì Google chặn OAuth trong embedded WebView), verify
# idToken ở server bằng Credentials Provider "mobile-google" (xem auth.ts).
# QUAN TRỌNG: đây KHÔNG phải 1 client ID mới — Google Credential Manager luôn
# phát hành idToken với audience = "Web application" Client ID (chính là
# AUTH_GOOGLE_ID ở trên), kể cả khi app là Android. Biến dưới đây chỉ là bản
# copy public (lộ ra client, không phải secret) của cùng giá trị AUTH_GOOGLE_ID,
# để plugin native dùng làm `webClientId` — bắt buộc phải khớp AUTH_GOOGLE_ID
# hệt nhau, nếu không idToken sẽ verify thất bại ở server.
# Ngoài ra vẫn phải tạo THÊM 1 OAuth Client ID loại "Android" riêng (package
# name + SHA-1 debug/release) tại Google Cloud Console > Credentials — không
# dán ID đó vào đây, nó chỉ để Google xác thực chữ ký APK, không dùng trong
# code (nhầm lẫn phổ biến, xem comment trong auth.ts).
NEXT_PUBLIC_AUTH_GOOGLE_ID=""

# SePay — xác nhận thanh toán chuyển khoản tự động qua webhook (xem
# src/app/api/webhooks/sepay/route.ts). Đăng ký + liên kết tài khoản ngân hàng +
# tạo API Token tại https://my.sepay.vn
# Số tài khoản ngân hàng đã liên kết trên SePay, dùng để tạo QR VietQR động
SEPAY_BANK_ACCOUNT_NUMBER=""
# Tên/alias ngân hàng theo chuẩn VietQR, vd "Vietcombank", "MBBank", "ACB"...
SEPAY_BANK_NAME=""
# Trên dashboard SePay, mục Webhooks -> tạo webhook mới:
#   URL: https://<domain-cua-ban>/api/webhooks/sepay
#   Phương thức xác thực: chọn "HMAC-SHA256" -> copy "Secret Key" (whsec_...)
#   dán vào đây. SePay ký request bằng key này, gửi kèm header
#   X-SePay-Signature/X-SePay-Timestamp để server verify (route.ts tự check).
SEPAY_WEBHOOK_SECRET=""

# Firebase Admin SDK — gửi push notification (FCM) cho app Android, xem
# src/lib/firebase-admin.ts, src/lib/push.ts. Tạo Firebase project riêng tại
# https://console.firebase.google.com (Project Settings -> Service Accounts ->
# Generate new private key) -> tải file JSON service-account -> base64-encode
# TOÀN BỘ nội dung file (tránh vấn đề xuống dòng của field "private_key" khi
# dán vào ô env var trên Vercel dashboard), dán chuỗi base64 đó vào đây.
# TUYỆT ĐỐI không commit file JSON gốc vào git.
FIREBASE_SERVICE_ACCOUNT_JSON=""
